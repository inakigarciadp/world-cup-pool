{
  "name": "world-cup-pool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:convex": "convex dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt . --check",
    "preview": "vite preview",
    "players:import:fifa": "node scripts/import-fifa-eligible-players.mjs --dry-run",
    "players:import:fifa:dev": "node scripts/import-fifa-eligible-players.mjs --deployment dev",
    "players:import:fifa:prod": "node scripts/import-fifa-eligible-players.mjs --deployment prod",
    "matches:import:fifa": "node scripts/import-fifa-matches.mjs --dry-run",
    "matches:import:fifa:dev": "node scripts/import-fifa-matches.mjs --deployment dev",
    "matches:import:fifa:prod": "node scripts/import-fifa-matches.mjs --deployment prod",
    "users:add": "node scripts/add-user.mjs",
    "users:sync:dev": "node scripts/sync-users-to-convex.mjs --deployment dev",
    "users:sync:prod": "node scripts/sync-users-to-convex.mjs --deployment prod"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.13",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
